PGDATABASE=
PGHOST=
PGPASSWORD=
PGPORT=
PGUSER=

# GitHub OAuth app — https://github.com/settings/developers
# Callback URL must be http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signs the session cookie. Any long random string; falls back to a dev default.
SESSION_SECRET=

# Where OAuth redirects back to (the Vite dev server, not this API)
CLIENT_URL=http://localhost:5173
